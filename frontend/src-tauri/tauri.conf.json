{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Hush",
    "version": "0.5.0",
    "identifier": "com.meetily.ai",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "Hush",
                "width": 1280,
                "height": 820,
                "minWidth": 720,
                "minHeight": 620,
                "resizable": true,
                "fullscreen": false,
                "theme": "Light",
                "decorations": true
            },
            {
                "label": "flow-bar",
                "title": "Hush Flow Bar",
                "url": "flow-bar.html",
                "width": 144,
                "height": 40,
                "minWidth": 132,
                "minHeight": 40,
                "resizable": false,
                "fullscreen": false,
                "transparent": true,
                "decorations": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "focus": false,
                "visible": false
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "base-uri": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost",
                "font-src": "'self' data:",
                "form-action": "'self'",
                "frame-ancestors": "'none'",
                "img-src": "'self' data:",
                "object-src": "'none'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "media-src": "'self' blob: data:"
            },
            "devCsp": {
                "default-src": "'self'",
                "base-uri": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3118 ws://localhost:3118",
                "font-src": "'self' data:",
                "form-action": "'self'",
                "frame-ancestors": "'none'",
                "img-src": "'self' data:",
                "object-src": "'none'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "media-src": "'self' blob: data:"
            },
            "capabilities": ["main", "flow-bar"]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "appimage",
            "msi",
            "nsis",
            "app",
            "dmg"
        ],
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/icon.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": [
            "templates/*.json",
            "resources/licenses/*"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg"
        ],
        "macOS": {
            "minimumSystemVersion": "14.2",
            "entitlements": "entitlements.plist",
            "infoPlist": "Info.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQTYzMUQ3ODc5N0M4MkEKUldRcXlKZUgxekdtN09DRkVWSHNpZlJseEVOUmpNd1dDSTNaLzZ3MXJGTnY3WW1pdnlOYjBpbkIK",
            "endpoints": [
                "https://github.com/henryvn27/hush/releases/latest/download/latest.json"
            ]
        }
    }
}
